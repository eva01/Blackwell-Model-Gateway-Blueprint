#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "${1:-}" = prerequisites ]; then
    shift
    exec bash "$project_root/scripts/prerequisites.sh" "$@"
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo 'Python 3 is missing. Run: ./gateway prerequisites --install' >&2
    exit 1
fi
exec python3 "$project_root/scripts/gateway_cli.py" "$@"
