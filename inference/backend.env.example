# Copy to a private backend.env; source only a file you trust.
# Detect the allocated device. Primary target: B200 MIG 4g.90gb; RTX is a demo.
GPU_PROFILE=auto
VLLM_IMAGE=nvcr.io/nvidia/vllm@sha256:0a0de9362545e3e062750bec4ad4f722422a04a81182b5258a7deda4325e9313
MODEL_ID=nvidia/Qwen3.8-27B-NVFP4
MODEL_REVISION=482ca0f3832238542f8f5295dde86b5f22711d80
SERVED_MODEL=qwen
# Total input + output capacity; qualify a real >=200K input before user rollout.
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.80
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=fp8_e4m3
VLLM_PORT=8000
VLLM_HOST=0.0.0.0
# Site-specific absolute paths. Do not commit the real backend.env.
MODEL_CACHE=/srv/qwen-model-cache
BACKEND_KEY_FILE=/etc/qwen-inference/backend.key
# Slurm/Pyxis: pre-import the pinned image with enroot, see deployment guide.
VLLM_SQSH=/shared/containers/qwen-vllm.sqsh
